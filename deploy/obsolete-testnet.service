[Unit]
Description=Obsolete Coin public testnet candidate node
After=network-online.target
Wants=network-online.target
[Service]
User=obsoletecoin
Group=obsoletecoin
StateDirectory=obsoletecoin-testnet
ExecStart=/opt/obsoletecoin/bitcoind -chain=obsolete-test -datadir=/var/lib/obsoletecoin-testnet -conf=/etc/obsoletecoin/testnet.conf
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/obsoletecoin-testnet
MemoryMax=1536M
TasksMax=128
LimitNOFILE=4096
[Install]
WantedBy=multi-user.target
